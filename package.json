{
  "name": "snap.hutao.remastered.docs",
  "version": "2.0.0",
  "description": "Documents site for Snap Hutao Remastered project",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "docs:build": "node generate-catalog.js && vitepress build docs",
    "docs:clean-dev": "node generate-catalog.js && vitepress dev docs --clean-cache",
    "docs:dev": "node generate-catalog.js && vitepress dev docs",
    "lint": "node --check generate-catalog.js && prettier --check package.json",
    "update:theme": "pnpm dlx vp-update",
    "prepare": "husky",
    "lint:all": "prettier --check ."
  },
  "devDependencies": {
    "@types/dom-view-transitions": "^1.0.6",
    "husky": "9.1.7",
    "markdown-it-container": "^4.0.0",
    "medium-zoom": "^1.1.0",
    "nano-staged": "1.0.2",
    "prettier": "3.9.10",
    "sass-embedded": "1.105.2",
    "vitepress": "^1.0.0",
    "vitepress-plugin-tabs": "^0.9.1",
    "vitepress-sidebar": "^1.40.0",
    "vue": "^3.5.44"
  },
  "engines": {
    "node": ">=18.19.0"
  },
  "nano-staged": {
    "*.{json,md,ts,vue}": "prettier --write"
  },
  "packageManager": "pnpm@9.15.0",
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "autoprefixer": "^10.6.1",
    "tailwindcss": "^4.3.3"
  }
}
